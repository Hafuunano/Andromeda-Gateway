# Active protocol driver: onebot | qqopen | sandbox
DRIVER=onebot

# Shared with Lucy app (may also be loaded by Lucy)
NICK_NAMES=
COMMAND_PREFIX=/
SUPER_USERS=

# plugin-agent SOUL / persona markdown (relative to Gateway cwd)
# SOUL_PERSONA_PATH=../Lucy/soul/PERSONA.md

# OneBot / ZeroBot WebSocket (DRIVER=onebot)
WS_URL=
WS_TOKEN=

# QQ Open Platform webhook (DRIVER=qqopen)
APP_ID=
APP_SECRET=
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=9000
WEBHOOK_PATH=/qqbot

# Sandbox local IM (DRIVER=sandbox)
SANDBOX_HOST=127.0.0.1
SANDBOX_PORT=9100
SANDBOX_TOKEN=
